<Window x:Class="RDPManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:RDPManager.Converters"
        mc:Ignorable="d"
        Title="RDP Manager Pro" Height="700" Width="1100"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="550"
        Icon="pack://application:,,,/RDPManager;component/Resources/app_icon.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:StatusToBrushConverter x:Key="StatusBrush"/>
        <converters:BoolToOpacityConverter x:Key="BoolOpacity"/>
    </Window.Resources>

    <!-- Main container with rounded corners -->
    <Border Background="{StaticResource BgDeepBrush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- CUSTOM TITLE BAR                               -->
            <!-- ═══════════════════════════════════════════════ -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebarBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- App Icon -->
                        <Border Width="20" Height="20" CornerRadius="4" Background="{StaticResource AccentBlueDarkBrush}" Margin="0,0,10,0">
                            <TextBlock Text="⊞" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="RDP Manager Pro" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="SemiBold" FontSize="13" FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="v1.0" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Click="MinimizeButton_Click" Style="{StaticResource GhostButton}"
                                Width="46" Height="40" FontSize="11"/>
                        <Button x:Name="MaxBtn" Content="□" Click="MaximizeButton_Click" Style="{StaticResource GhostButton}"
                                Width="46" Height="40" FontSize="13"/>
                        <Button Content="✕" Click="CloseButton_Click" Width="46" Height="40" FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" CornerRadius="0,10,0,0" Padding="8,6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════ -->
            <!-- MAIN CONTENT                                   -->
            <!-- ═══════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ═══════════════════════════════════════════ -->
                <!-- SIDEBAR                                    -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Background="{StaticResource BgSidebarBrush}" BorderThickness="0,0,1,0"
                        BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Search Bar -->
                        <Border Grid.Row="0" Margin="12,12,12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="SearchBox"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="32,8,10,8"
                                             FontSize="12"/>
                                    <TextBlock Text="🔍" FontSize="13" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="Rechercher..." FontSize="12" IsHitTestVisible="False"
                                               VerticalAlignment="Center" Margin="32,0,0,0"
                                               Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Button Grid.Column="1" Command="{Binding RefreshStatusCommand}"
                                        Margin="6,0,0,0" Cursor="Hand"
                                        ToolTip="Actualiser les statuts">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                                <Path x:Name="path" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"
                                                      Fill="{StaticResource TextMutedBrush}" 
                                                      Stretch="Uniform" Width="14" Height="14" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                    <Setter TargetName="path" Property="Fill" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding GoHomeCommand}"
                                        Margin="4,0,0,0" Cursor="Hand"
                                        ToolTip="Tableau de Bord">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                                <TextBlock x:Name="txt" Text="⌂" Foreground="{StaticResource TextMutedBrush}" 
                                                           FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Filter -->
                        <Border Grid.Row="1" Background="{StaticResource BgInputBrush}" CornerRadius="10" Margin="12,4,12,12" Padding="2">
                            <UniformGrid Columns="3">
                                <RadioButton Content="Tous" GroupName="Filter"
                                             IsChecked="True" Style="{StaticResource SegmentedRadioButtonStyle}"
                                             Checked="FilterAll_Checked"/>
                                <RadioButton Content="RDP" GroupName="Filter"
                                             Style="{StaticResource SegmentedRadioButtonStyle}"
                                             Checked="FilterRDP_Checked"/>
                                <RadioButton Content="SSH" GroupName="Filter"
                                             Style="{StaticResource SegmentedRadioButtonStyle}"
                                             Checked="FilterSSH_Checked"/>
                            </UniformGrid>
                        </Border>

                        <!-- Grouped Connection List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Group Header -->
                                            <Border Margin="6,4,6,0" Cursor="Hand"
                                                    Background="Transparent"
                                                    MouseLeftButtonDown="GroupHeader_Click">
                                                <Border.Tag>
                                                    <Binding/>
                                                </Border.Tag>
                                                <Grid Margin="8,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BoolOpacity}}"
                                                               Visibility="Collapsed"/>
                                                    <TextBlock Grid.Column="0" FontSize="9"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="▶"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Text" Value="▼"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <Border Grid.Column="2" Background="{StaticResource BgCardBrush}"
                                                            CornerRadius="8" Padding="6,2" MinWidth="20"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Connections.Count}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10" HorizontalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- Group Connections -->
                                            <ItemsControl ItemsSource="{Binding Connections}"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="connItem" Margin="6,2,6,2"
                                                                Padding="16,12" CornerRadius="8"
                                                                Background="Transparent" Cursor="Hand"
                                                                MouseLeftButtonDown="Connection_Click">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- Status dot -->
                                                                <Ellipse Grid.Column="0" Width="10" Height="10"
                                                                         Fill="{Binding IsOnline, Converter={StaticResource StatusBrush}}"
                                                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                                <!-- Name & Host -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               FontSize="14" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Foreground="{StaticResource TextMutedBrush}"
                                                                               FontSize="11" Margin="0,2,0,0"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Host, Mode=OneWay}"/>
                                                                        <Run Text=":" Foreground="{StaticResource TextMutedBrush}"/>
                                                                        <Run Text="{Binding Port, Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <!-- Connection type badge & Sort Buttons -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Padding="6,2" CornerRadius="4" Background="{StaticResource BgCardBrush}" x:Name="typeBadge">
                                                                        <TextBlock Text="{Binding ConnectionType}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                                                                    </Border>
                                                                    
                                                                    <!-- Mini Sort Buttons (Visible on Hover) -->
                                                                    <StackPanel x:Name="sortPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                                                        <Button Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="20" Height="20" Padding="0">
                                                                            <TextBlock Text="↑" FontSize="10"/>
                                                                        </Button>
                                                                        <Button Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Width="20" Height="20" Padding="0" Margin="2,0,0,0">
                                                                            <TextBlock Text="↓" FontSize="10"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="connItem" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="connItem" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                                                <Setter TargetName="sortPanel" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="typeBadge" Property="Visibility" Value="Collapsed"/>
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Bottom Actions -->
                        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="＋ Ajouter" Command="{Binding AddCommand}"
                                        HorizontalAlignment="Stretch" Style="{StaticResource GhostButton}"
                                        Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
                                <Button Grid.Column="1" Content="📁" Command="{Binding ShowAddGroupCommand}"
                                        Style="{StaticResource GhostButton}" Width="36" Height="36"
                                        FontSize="15" ToolTip="Nouveau groupe" Margin="4,0"/>
                                <Button Grid.Column="2" Content="⚙" Command="{Binding SettingsCommand}"
                                        Style="{StaticResource GhostButton}" Width="36" Height="36"
                                        FontSize="15" ToolTip="Paramètres"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- MAIN CONTENT AREA                          -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Column="1">

                    <!-- Dashboard View (No Selection) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Style="{StaticResource AnimatedContent}"
                                  Visibility="{Binding IsConnectionSelected, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Margin="40,30" MaxWidth="1000">
                            <!-- Welcome -->
                            <TextBlock Text="Tableau de Bord" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Gérez vos accès distants avec efficacité." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,30"/>

                            <!-- Stats Row -->
                            <UniformGrid Columns="3" Margin="0,0,0,35">
                                <Border Background="{StaticResource BgCardBrush}" Padding="35,25" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="Total" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TotalConnections}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="38" FontWeight="Bold" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCardBrush}" Padding="35,25" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,16,0">
                                    <StackPanel>
                                        <TextBlock Text="En Ligne" Foreground="{StaticResource AccentGreenBrush}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OnlineConnections}" Foreground="{StaticResource AccentGreenBrush}" FontSize="38" FontWeight="Bold" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgCardBrush}" Padding="35,25" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Hors Ligne" Foreground="{StaticResource AccentRedBrush}" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding OfflineConnections}" Foreground="{StaticResource AccentRedBrush}" FontSize="38" FontWeight="Bold" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Two Columns Section -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="320"/>
                                </Grid.ColumnDefinitions>

                                <!-- Recent Activity -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ACTIVITÉ RÉCENTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,15"/>
                                    <ItemsControl ItemsSource="{Binding RecentConnections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardBrush}" Margin="0,0,0,12" Padding="24,20" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource BgHoverBrush}" HorizontalAlignment="Left">
                                                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="22">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="⊞"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ConnectionType}" Value="SSH">
                                                                                <Setter Property="Text" Value=">_"/>
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}"/>
                                                                                <Setter Property="FontSize" Value="18"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding LastConnectedText}" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Reconnecter" Style="{StaticResource GhostButton}" 
                                                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Padding="20,10" FontSize="14" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                    <!-- Empty recent state -->
                                    <Border Background="{StaticResource BgCardBrush}" Padding="30" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecentConnections.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="Aucune activité récente." HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Quick Actions -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ACTIONS RAPIDES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,15"/>
                                    <Button Content="＋ Nouvelle Connexion" Command="{Binding AddCommand}" HorizontalAlignment="Stretch" Padding="15" Margin="0,0,0,10"/>
                                    <Button Content="📁 Créer un Groupe" Command="{Binding ShowAddGroupCommand}" HorizontalAlignment="Stretch" Style="{StaticResource GhostButton}" Padding="15" Margin="0,0,0,10"/>
                                    <Button Content="⚙ Paramètres" Command="{Binding SettingsCommand}" HorizontalAlignment="Stretch" Style="{StaticResource GhostButton}" Padding="15"/>
                                    
                                    <Border Margin="0,25,0,0" Padding="20" Background="{StaticResource AccentBlueDarkBrush}" CornerRadius="12" Opacity="0.9"
                                            Visibility="{Binding IsTipVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="💡 Astuce" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                                <TextBlock Text="Utilisez le raccourci dans la zone de notification pour lancer vos sessions favorites sans ouvrir l'application complète." 
                                                           TextWrapping="Wrap" FontSize="11" Foreground="#CCFFFFFF" LineHeight="16"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                    Command="{Binding CloseTipCommand}"
                                                    Style="{StaticResource GhostButton}" Foreground="White" 
                                                    Width="24" Height="24" Padding="0" Margin="0,-10,-10,0">
                                                <TextBlock Text="✕" FontSize="10"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Connection Detail Form -->
                    <Grid Visibility="{Binding IsConnectionSelected, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource AnimatedContent}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="30,20" BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBox Text="{Binding SelectedConnection.Name, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="22" FontWeight="Bold" Background="Transparent"
                                             BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                                             Padding="0" Margin="0,0,0,8" MinWidth="250"/>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedConnection.ConnectionType}"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   FontSize="11" FontWeight="Bold" Margin="0,0,12,0"/>
                                        <TextBlock Text="Dernière connexion :" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SelectedConnection.LastConnectedText}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="▶  CONNECTER"
                                        Command="{Binding ConnectCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="13" Padding="24,12"/>
                            </Grid>
                        </Border>

                        <!-- Form ScrollView -->
                        <ScrollViewer Grid.Row="1" Padding="30,20" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="600">

                                <!-- ── GENERAL SECTION ── -->
                                <TextBlock Text="GÉNÉRAL" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                        Padding="20" Margin="0,0,0,20"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Nom de la connexion" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding SelectedConnection.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hôte / Adresse IP" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding SelectedConnection.Host, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Port" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding SelectedConnection.Port, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Groupe" FontSize="12" Margin="0,14,0,6"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding SelectedConnection.Group, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Type de connexion" FontSize="12" Margin="0,14,0,6"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox SelectedValue="{Binding SelectedConnection.ConnectionType, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag"
                                                  Padding="10,8" FontSize="13" 
                                                  Background="{StaticResource BgInputBrush}" 
                                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                                  BorderBrush="{StaticResource BorderBrush}">
                                            <ComboBoxItem Content="Bureau à distance" Tag="RDP"/>
                                            <ComboBoxItem Content="Connexion SSH" Tag="SSH"/>
                                        </ComboBox>

                                        <TextBlock Text="Description" FontSize="12" Margin="0,14,0,6"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding SelectedConnection.Description, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 Height="60" VerticalContentAlignment="Top"/>
                                    </StackPanel>
                                </Border>

                                <!-- ── CREDENTIALS SECTION (SSH ONLY) ── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedConnection.ConnectionType}" Value="SSH">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    
                                    <TextBlock Text="IDENTIFIANTS" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                            Padding="20" Margin="0,0,0,20"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Nom d'utilisateur" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                            <TextBox Text="{Binding SelectedConnection.Username, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ── RDP ONLY SETTINGS ── -->
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedConnection.ConnectionType}" Value="RDP">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    
                                    <!-- ── DISPLAY SECTION ── -->
                                    <TextBlock Text="AFFICHAGE" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                            Padding="20" Margin="0,0,0,20"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding SelectedConnection.FullScreen}"
                                                      Content="Plein écran" Margin="0,0,0,12"/>
                                            <CheckBox IsChecked="{Binding SelectedConnection.UseMultimon}"
                                                      Content="Utiliser tous les écrans (multi-moniteur)"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ── RESOURCES SECTION ── -->
                                    <TextBlock Text="RESSOURCES LOCALES" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,12"/>

                                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="8"
                                            Padding="20" Margin="0,0,0,20"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding SelectedConnection.RedirectClipboard}"
                                                      Content="Presse-papiers (Copier/Coller)" Margin="0,0,0,12"/>
                                            <CheckBox IsChecked="{Binding SelectedConnection.RedirectPrinters}"
                                                      Content="Imprimantes locales" Margin="0,0,0,12"/>
                                            <CheckBox IsChecked="{Binding SelectedConnection.RedirectDrives}"
                                                      Content="Disques durs locaux"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" Padding="30,12" Background="{StaticResource BgSidebarBrush}"
                                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Content="Supprimer" Command="{Binding DeleteCommand}"
                                            Style="{StaticResource DangerButton}" Padding="16,8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Enregistrer" Command="{Binding SaveCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="20,8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- NOTIFICATION TOAST                     -->
                    <!-- ═══════════════════════════════════════ -->
                    <Grid VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                          Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="8" Padding="16,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUndoVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentRedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NotificationMessage}" Foreground="White"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <Button Content="Annuler" Command="{Binding UndoDeleteCommand}"
                                        Visibility="{Binding IsUndoVisible, Converter={StaticResource BoolToVis}}"
                                        Foreground="#CCFFFFFF" FontSize="12" Margin="14,0,0,0"
                                        VerticalAlignment="Center" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}"
                                                       TextDecorations="Underline"
                                                       Foreground="{TemplateBinding Foreground}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- DELETE CONFIRMATION OVERLAY             -->
                    <!-- ═══════════════════════════════════════ -->
                    <Grid Background="#CC000000"
                          Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="30" MinWidth="380">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⚠ Confirmation" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="{Binding DeleteConfirmationMessage}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="14" TextWrapping="Wrap" Margin="0,0,0,24"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Annuler" Command="{Binding CancelDeleteCommand}"
                                            Margin="0,0,10,0" Padding="16,8"/>
                                    <Button Content="Supprimer" Command="{Binding ConfirmDeleteCommand}"
                                            Style="{StaticResource DangerButton}" Padding="20,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- SETTINGS OVERLAY                       -->
                    <!-- ═══════════════════════════════════════ -->
                    <Grid Background="#CC000000"
                          Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="30" MinWidth="420">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,24">
                                    <TextBlock Text="⚙ Paramètres" FontSize="20" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Content="✕" Command="{Binding CloseSettingsCommand}"
                                            Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Right" Width="30" Height="30"
                                            FontSize="14"/>
                                </Grid>

                                <TextBlock Text="APPLICATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                                <CheckBox IsChecked="{Binding StartWithWindows}"
                                          Content="Lancer avec Windows" Margin="0,0,0,14"/>
                                <CheckBox IsChecked="{Binding MinimizeToTray}"
                                          Content="Réduire dans la zone de notification" Margin="0,0,0,14"/>

                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,16"/>

                                <TextBlock Text="RÉSEAU" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                                <CheckBox IsChecked="{Binding CheckOnlineStatus}"
                                          Content="Vérifier le statut des connexions (ping)" Margin="0,0,0,14"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                                    <Button Content="Fermer" Command="{Binding CloseSettingsCommand}"
                                            Margin="0,0,10,0" Padding="16,8"/>
                                    <Button Content="Enregistrer" Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="20,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════ -->
                    <!-- ADD GROUP OVERLAY                       -->
                    <!-- ═══════════════════════════════════════ -->
                    <Grid Background="#CC000000"
                          Visibility="{Binding IsAddGroupVisible, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Padding="30" MinWidth="380">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📁 Nouveau Groupe" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>
                                <TextBlock Text="Nom du groupe" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,20"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Annuler" Command="{Binding CancelAddGroupCommand}"
                                            Margin="0,0,10,0" Padding="16,8"/>
                                    <Button Content="Créer" Command="{Binding CreateGroupCommand}"
                                            Style="{StaticResource PrimaryButton}" Padding="20,8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
